{
  "manifest_version": 3,
  "name": "Clear Pop Up",
  "version": "0.1.0",
  "description": "Bloque les pop-up et masque les overlays. Tout reste local, sans suivi ni collecte.",
  "minimum_chrome_version": "119",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Clear Pop Up"},
  "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'self'; style-src 'self'"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true, "match_origin_as_fallback": true}]
}
